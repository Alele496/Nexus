        "@nexus/nexus-darwin-x64": "0.2.0-dev",
        "@nexus/nexus-linux-arm64": "0.2.0-dev",
        "@nexus/nexus-linux-x64": "0.2.0-dev",
        "@nexus/nexus-win32-arm64": "0.2.0-dev",
        "@nexus/nexus-win32-x64": "0.2.0-dev"
