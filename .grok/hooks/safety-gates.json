{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const input=require('fs').readFileSync('/dev/stdin','utf8');const data=JSON.parse(input);const cmd=(data.toolInput||{}).command||'';if(/rm\\\\s+-rf\\\\s+\\\\//.test(cmd)||/git\\\\s+push\\\\s+--force/.test(cmd)||/git\\\\s+reset\\\\s+--hard/.test(cmd)||/DROP\\\\s+(TABLE|DATABASE)/i.test(cmd)){process.stdout.write(JSON.stringify({decision:'deny',reason:'Blocked potentially destructive command: '+cmd.slice(0,80)}));process.exit(2);}else{process.stdout.write(JSON.stringify({decision:'allow'}));}\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const input=require('fs').readFileSync('/dev/stdin','utf8');const data=JSON.parse(input);const filePath=((data.toolInput||{}).file_path||'');if(/\\.env$/.test(filePath)&&!/\\.env\\\\.example$/.test(filePath)){process.stdout.write(JSON.stringify({decision:'deny',reason:'Blocked write to sensitive file: '+filePath}));process.exit(2);}else{process.stdout.write(JSON.stringify({decision:'allow'}));}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const input=require('fs').readFileSync('/dev/stdin','utf8');const data=JSON.parse(input);const cmd=(data.toolInput||{}).command||'';if(/git\\\\s+push/.test(cmd)&&!/force/.test(cmd)){console.error('[Agent-SYS Hook] git push detected — ensure review gate was passed');}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const input=require('fs').readFileSync('/dev/stdin','utf8');const data=JSON.parse(input);const sessionId=data.sessionId||'unknown';console.error('[Agent-SYS Hook] Session stop: '+sessionId);\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const input=require('fs').readFileSync('/dev/stdin','utf8');console.error('[Agent-SYS Hook] Subagent completed');\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
