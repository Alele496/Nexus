{
  "name": "nexus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus agent desktop shell (Electron)",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix ../nexus-web run build",
    "start": "npm run build && electron .",
    "dev": "npm run build && npm run build:web && electron .",
    "dev:hud": "npm run build && electron . --dev-url=http://127.0.0.1:5173",
    "smoke": "npm run build && electron . --smoke",
    "dist": "npm run build && npm run build:web && electron-builder --win",
    "dist:dir": "npm run build && npm run build:web && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3"
  }
}
